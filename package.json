{
  "name": "ai-optimizer",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "AI Token Optimizer monorepo root",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivam-app-developers/ai-optimizer.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai",
    "token-optimization",
    "context-optimizer",
    "claude",
    "cursor"
  ],
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build -w @ai-optimizer/core && npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
